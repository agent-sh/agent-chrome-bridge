{
  "manifest_version": 3,
  "name": "Agent Chrome Bridge",
  "version": "0.3.2",
  "description": "Shared local Chrome bridge for Codex and Claude.",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Chrome Bridge"
  }
}
